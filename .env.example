# Copy to .env on the Raspberry Pi. Never commit or paste your real key into chat.
# For DeepSeek vision: use OPENAI_BASE_URL=https://api.deepseek.com and
# VLM_MODEL=deepseek-v4-flash-vision-exp. The variable name remains OPENAI_API_KEY
# because the project uses an OpenAI-compatible interface.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-5.6-luna
ENABLE_CLOUD_VISION=false
CAMERA_STILL_SECONDS=1.5
CAMERA_MOTION_THRESHOLD=8.0
TTS_VOICE=da
VOSK_MODEL_PATH=models/vosk-small-cn
# Persistent Pi-local picture-book memory.  Relative paths are under the project folder.
PAGE_MEMORY_ENABLED=true
PAGE_MEMORY_DIR=data/picture-book-library
# 64-bit perceptual-hash distance; lower is stricter.  Keep the tested default unless calibrated.
PAGE_MATCH_DISTANCE=7
