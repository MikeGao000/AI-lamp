# Copy to .env on the Raspberry Pi or a dev machine. Never commit or paste your real key into chat.
# Everything here equals the code default (lamp_core/config.py); with ENABLE_CLOUD_VISION=false
# no key is needed and unit tests / simulations run offline.
# For DeepSeek vision: use OPENAI_BASE_URL=https://api.deepseek.com and
# VLM_MODEL=deepseek-v4-flash-vision-exp. The variable name remains OPENAI_API_KEY
# because the project uses an OpenAI-compatible interface.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-5.6-luna
ENABLE_CLOUD_VISION=false
CLOUD_STREAM=true
CLOUD_REASONING_EFFORT=none
CLOUD_MAX_OUTPUT_TOKENS=700
CAMERA_STILL_SECONDS=1.5
CAMERA_MOTION_THRESHOLD=8.0
READING_LANGUAGE=Danish
QUESTION_REPLY_LANGUAGE=Danish
# TTS_PROVIDER=local uses the on-device voice (TTS_VOICE); other providers use TTS_MODEL/OPENAI_TTS_VOICE.
# TTS_INSTRUCTIONS (voice style prompt) has a long built-in default; set it only to override.
TTS_PROVIDER=local
TTS_VOICE=da
TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
TTS_SPEED=0.94
TTS_TIMEOUT_SECONDS=30
VOSK_MODEL_PATH=models/vosk-small-cn
# Persistent Pi-local picture-book memory.  Relative paths are under the project folder.
PAGE_MEMORY_ENABLED=true
PAGE_MEMORY_DIR=data/picture-book-library
# 64-bit perceptual-hash distance; lower is stricter.  Keep the tested default unless calibrated.
PAGE_MATCH_DISTANCE=7
# Enable only after a microphone and acoustic echo cancellation are configured.
MICROPHONE_ENABLED=false
MICROPHONE_DEVICE=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MICROPHONE_VAD_RMS=650
MICROPHONE_BARGE_IN_MULTIPLIER=1.8
