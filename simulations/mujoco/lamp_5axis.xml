<!--
  Five-axis desk-lamp geometry for offline MuJoCo playback and later training.
  User-provided centre-to-centre structure: base U-link 50 mm, large arm 200 mm,
  small arm 90 mm, neck U-link 50 mm.  All five joint housings represent 42 mm
  stepper motors; only link widths and lamp-head proportions remain visual placeholders.
-->
<mujoco model="lamp_5axis">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <default>
    <!-- Kinematic first model: geometry is visual until masses and contact are calibrated. -->
    <geom contype="0" conaffinity="0" friction="0.8 0.1 0.1"/>
  </default>

  <worldbody>
    <geom name="desk" type="plane" size="2 2 0.1" rgba="0.12 0.12 0.12 1"/>
    <light name="room_light" pos="-0.4 -0.7 1.5" diffuse="0.8 0.8 0.8"/>

    <body name="base" pos="0 0 0.04">
      <geom name="base_shell" type="cylinder" size="0.14 0.04" mass="1.2"
            rgba="0.18 0.20 0.24 1"/>

      <!-- J1: base yaw. -->
      <body name="j1_base" pos="0 0 0.05">
        <joint name="j1_base_yaw" type="hinge" axis="0 0 1"
               range="-1.57 1.57" damping="1.2" armature="0.015"/>
        <!-- 42 x 42 x 40 mm stepper motor; the shaft is vertical (Z). -->
        <geom name="j1_motor" type="box" size="0.021 0.021 0.020" mass="0.35"
              rgba="0.30 0.36 0.44 1"/>

        <!-- Red lower U-arm: joins the vertical J1 motor to the horizontal J2 motor. -->
        <geom name="base_u_left" type="box" pos="0 -0.027 0.025" size="0.016 0.004 0.025"
              mass="0.03" rgba="0.34 0.25 0.18 1"/>
        <geom name="base_u_right" type="box" pos="0 0.027 0.025" size="0.016 0.004 0.025"
              mass="0.03" rgba="0.34 0.25 0.18 1"/>
        <geom name="base_u_bridge" type="box" pos="0 0 0" size="0.016 0.031 0.004"
              mass="0.03" rgba="0.34 0.25 0.18 1"/>
        <!-- J2: shoulder pitch sits inside the top of the first 50 mm fork. -->
        <body name="j2_shoulder" pos="0 0 0.05">
          <joint name="j2_shoulder" type="hinge" axis="0 1 0"
                 range="-0.78 0.78" damping="1.0" armature="0.012"/>
          <!-- 42 x 42 x 40 mm stepper motor; the shaft is along Y. -->
          <geom name="j2_motor" type="box" size="0.021 0.020 0.021"
                mass="0.18" rgba="0.18 0.20 0.24 1"/>
          <!-- Red 200 mm main arm: a plate-like member between J2 and J3. -->
          <geom name="large_arm_200mm" type="box" pos="0.10 0 0"
                size="0.10 0.015 0.018" mass="0.22" rgba="0.34 0.25 0.18 1"/>

          <!-- J3: elbow pitch, located at the end of the 200 mm large arm. -->
          <body name="j3_elbow" pos="0.20 0 0">
            <joint name="j3_elbow" type="hinge" axis="0 1 0"
                   range="-0.95 0.95" damping="0.9" armature="0.010"/>
            <!-- 42 x 42 x 40 mm stepper motor; the shaft is along Y. -->
            <geom name="j3_motor" type="box" size="0.021 0.020 0.021"
                  mass="0.15" rgba="0.18 0.20 0.24 1"/>
            <!-- Red 90 mm forearm: a plate-like member between J3 and J4. -->
            <geom name="small_arm_90mm" type="box" pos="0.045 0 0"
                  size="0.045 0.014 0.016" mass="0.16" rgba="0.34 0.25 0.18 1"/>

            <!-- J4: neck pitch, located at the end of the 90 mm small arm. -->
            <body name="j4_neck" pos="0.09 0 0">
              <joint name="j4_neck_pitch" type="hinge" axis="0 1 0"
                     range="-0.70 0.70" damping="0.7" armature="0.008"/>
              <!-- 42 x 42 x 40 mm stepper motor; the shaft is along Y. -->
              <geom name="j4_motor" type="box" size="0.021 0.020 0.021"
                    mass="0.12" rgba="0.18 0.20 0.24 1"/>

              <!-- Red upper U-arm: joins horizontal J4 to vertical J5. -->
              <geom name="neck_u_left" type="box" pos="0 -0.027 0.025" size="0.014 0.004 0.025"
                    mass="0.03" rgba="0.34 0.25 0.18 1"/>
              <geom name="neck_u_right" type="box" pos="0 0.027 0.025" size="0.014 0.004 0.025"
                    mass="0.03" rgba="0.34 0.25 0.18 1"/>
              <geom name="neck_u_bridge" type="box" pos="0 0 0" size="0.014 0.031 0.004"
                    mass="0.03" rgba="0.34 0.25 0.18 1"/>

              <!-- J5 sits in the terminal fork opening and rotates the head horizontally. -->
              <body name="j5_head" pos="0 0 0.05">
                <joint name="j5_head_yaw" type="hinge" axis="0 0 1"
                       range="-1.05 1.05" damping="0.6" armature="0.006"/>
                <!-- 42 x 42 x 40 mm stepper motor; the shaft is vertical (Z). -->
                <geom name="j5_motor" type="box" size="0.021 0.021 0.020" mass="0.10"
                      rgba="0.18 0.20 0.24 1"/>
                <!-- The vertical J5 shaft carries the lamp head above the motor, not beside it. -->
                <geom name="head_riser" type="box" pos="0 0 0.037" size="0.014 0.014 0.037"
                      mass="0.04" rgba="0.34 0.25 0.18 1"/>
                <geom name="head_adapter_plate" type="box" pos="0 0 0.075"
                      size="0.030 0.024 0.005" mass="0.04" rgba="0.34 0.25 0.18 1"/>
                <body name="lamp_head" pos="0 0 0.075">
                  <!-- 130 x 100 x 80 mm head: about 2.4 times the 42 mm motor face. -->
                  <geom name="head_shell" type="ellipsoid" size="0.065 0.050 0.040" mass="0.25"
                        rgba="0.30 0.31 0.33 1"/>
                  <geom name="light_diffuser" type="cylinder" pos="0.055 0 0" size="0.035 0.005"
                        euler="0 1.5708 0" mass="0.02" rgba="0.95 0.95 0.82 1"/>
                  <camera name="lamp_camera" pos="0.076 0 0" xyaxes="0 -1 0 0 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- ctrlrange makes the native Simulate UI expose bounded drag sliders. -->
    <position name="j1_position" joint="j1_base_yaw" kp="4" forcelimited="true" forcerange="-0.96 0.96" ctrllimited="true" ctrlrange="-1.57 1.57"/>
    <position name="j2_position" joint="j2_shoulder" kp="3" forcelimited="true" forcerange="-0.72 0.72" ctrllimited="true" ctrlrange="-0.78 0.78"/>
    <position name="j3_position" joint="j3_elbow" kp="3" forcelimited="true" forcerange="-0.72 0.72" ctrllimited="true" ctrlrange="-0.95 0.95"/>
    <position name="j4_position" joint="j4_neck_pitch" kp="2" forcelimited="true" forcerange="-0.60 0.60" ctrllimited="true" ctrlrange="-0.70 0.70"/>
    <position name="j5_position" joint="j5_head_yaw" kp="2" forcelimited="true" forcerange="-0.60 0.60" ctrllimited="true" ctrlrange="-1.05 1.05"/>
  </actuator>

  <keyframe>
    <key name="idle" qpos="0 0 0 0 0"/>
    <key name="look_left" qpos="-0.55 -0.08 0.12 0.10 0.30"/>
    <key name="look_right" qpos="0.55 -0.08 0.12 0.10 -0.30"/>
    <key name="reading" qpos="0.25 -0.20 0.30 0.12 -0.18"/>
  </keyframe>
</mujoco>
